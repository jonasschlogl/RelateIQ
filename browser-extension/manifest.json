{
  "manifest_version": 3,
  "name": "RelateIQ Message Coach",
  "short_name": "RelateIQ",
  "version": "1.0.0",
  "description": "Get a calmer, clearer rewrite of your message before you send it — right inside WhatsApp Web and Messenger.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://terrific-spirit-production.up.railway.app/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["shared.js", "content-whatsapp.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.messenger.com/*", "https://messenger.com/*"],
      "js": ["shared.js", "content-messenger.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
