OPENAI_API_KEY=sk-...
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# --- Stripe (payments) ---------------------------------------------------
# Optional: leave these blank and the app runs fine, it just won't be able
# to take payments (Upgrade buttons will show a "not set up yet" error).
# See the "Payments (Stripe)" section in README.md for how to fill these in.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000

# --- Persistent storage (only needed when deploying) ----------------------
# Leave commented out for local dev — the app just uses ./data/db.json and
# ./public/uploads/. Set these when deploying somewhere with a persistent
# volume, pointing at a path inside that volume. See "Deploying to
# production" in README.md.
# DB_PATH=/data/db.json
# UPLOADS_DIR=/data/uploads

# --- Email (Resend) --------------------------------------------------------
# Optional: leave blank and the app runs fine, it just won't send the daily
# check-in reminder or weekly insights digest emails (a warning is logged
# on boot instead). Sign up at resend.com, verify a sending domain (or use
# their onboarding@resend.dev sender for testing), and put the API key here.
# RESEND_API_KEY=re_...
# EMAIL_FROM=RelateIQ <hello@yourdomain.com>

# --- Browser push notifications (Web Push) ---------------------------------
# Optional: leave blank and the app runs fine, it just won't send browser
# push notifications (a warning is logged on boot, and the "Enable
# notifications" button on the dashboard will fail if pressed). Generate a
# key pair once with `npx web-push generate-vapid-keys` and paste the two
# keys below — they're not secret in the sense of a password, but the
# private key should still not be committed anywhere public.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@yourdomain.com

# --- Admin / growth dashboard ----------------------------------------------
# Optional: leave blank and /admin.html refuses everyone. Comma-separated
# list of the account email(s) that should see the Admin link and the
# growth dashboard (signups, plan breakdown, conversations, referrals, etc).
# ADMIN_EMAILS=you@yourdomain.com
